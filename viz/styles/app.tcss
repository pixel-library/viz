/* Viz Terminal Media Center — Professional Orange + White Theme Stylesheet */
/* Professional, keyboard-first design with Orange (#FF8800) accent palette */

* {
    scrollbar-size-vertical: 0;
    scrollbar-size-horizontal: 0;
    scrollbar-size: 0 0;
}

Screen {
    background: #FFFDF8;
    color: #1A1A1A;
}

/* ═══════════════════════════════════════ HEADER ═══════════════════════════════════════ */

HeaderWidget {
    align: center top;
    height: auto;
    max-height: 8;
    margin: 0;
    padding: 0;
    background: #FFFDF8;
    color: #FF8800;
}

#top-status-line {
    text-align: center;
    color: #FF8800;
    height: auto;
    background: #FFFDF8;
    width: 100%;
}

/* ═══════════════════════════════════════ MAIN LAYOUT ═══════════════════════════════════ */

.main-box {
    border: round #FF8800;
    height: 1fr;
    margin: 0 1;
    background: #FFFFFF;
}

.column {
    height: 100%;
    padding: 0 1;
}

#left-column {
    width: 25%;
    min-width: 22;
    height: 100%;
    padding: 0 1;
    border-right: solid #FFE1B8;
}

#center-column {
    width: 50%;
    min-width: 32;
    height: 100%;
    padding: 0 1;
    border-right: solid #FFE1B8;
}

#details-column {
    width: 25%;
    min-width: 22;
    height: 100%;
    padding: 0 1;
}

.column-header {
    text-style: bold;
    color: #CC6600;
    margin-bottom: 0;
    padding-bottom: 0;
    border-bottom: heavy #FF8800;
}

/* ═══════════════════════════════════════ FILESYSTEM TREE ═══════════════════════════════ */

#folder-tree {
    height: 1fr;
    min-height: 6;
    border: none;
    background: #FFFFFF;
    color: #1A1A1A;
    scrollbar-size-vertical: 0;
    scrollbar-size-horizontal: 0;
    scrollbar-size: 0 0;
}

#folder-tree:focus {
    border: none;
}

#folder-tree > .tree--cursor {
    background: #FFE1B8;
    color: #CC6600;
    text-style: bold;
}

#folder-tree > .tree--highlight {
    background: #FFF5E8;
    color: #FF8800;
}

/* ═══════════════════════════════════════ SIDEBAR SECTIONS ══════════════════════════════ */

.section-header {
    color: #CC6600;
    text-style: bold;
    padding-top: 0;
    margin-bottom: 0;
}

#storage-list, #personal-views-list, #system-list {
    height: auto;
    max-height: 4;
    border: none;
    background: #FFFFFF;
    scrollbar-size: 0 0;
}

#storage-list > ListItem, #personal-views-list > ListItem, #system-list > ListItem {
    padding: 0 1;
    color: #444444;
    background: #FFFFFF;
}

#storage-list > ListItem:hover, #personal-views-list > ListItem:hover, #system-list > ListItem:hover {
    background: #FFF5E8;
    color: #FF8800;
}

#storage-list > ListItem.--highlight, #personal-views-list > ListItem.--highlight, #system-list > ListItem.--highlight {
    background: #FFE1B8;
    color: #CC6600;
    text-style: bold;
}

/* ═══════════════════════════════════════ MEDIA LIST ════════════════════════════════════ */

#media-list {
    height: 1fr;
    border: none;
    background: #FFFFFF;
    scrollbar-size-vertical: 0;
    scrollbar-size-horizontal: 0;
    scrollbar-size: 0 0;
}

#media-list > ListItem {
    padding: 0 1;
    color: #1A1A1A;
    background: #FFFFFF;
}

#media-list > ListItem:hover {
    background: #FFF5E8;
    color: #FF8800;
}

#media-list > ListItem.--highlight {
    background: #FFE1B8;
    color: #CC6600;
    text-style: bold;
}

#details-body {
    height: 1fr;
    padding: 1 0;
    color: #1A1A1A;
    scrollbar-size: 0 0;
    overflow-y: auto;
}

#storage-header {
    margin-top: 1;
    margin-bottom: 0;
    border-top: solid #FF8800;
    color: #CC6600;
    text-style: bold;
}

#storage-body {
    height: auto;
    min-height: 6;
    padding: 0 0;
    color: #1A1A1A;
}


/* ═══════════════════════════════════════ VIDEO ENVIRONMENT ═══════════════════════════════ */

#video-screen-container {
    width: 100%;
    height: 100%;
    background: #08090b;
    color: #e4e8ef;
    padding: 0 1;
}

#video-header-bar {
    height: 1;
    width: 100%;
    background: #11141c;
    color: #ffffff;
    padding: 0 1;
}

#video-brand {
    color: #ff8800;
    text-style: bold;
    width: 26;
}

#video-title-label {
    width: 1fr;
    text-align: center;
    color: #ffffff;
    text-style: bold;
}

#video-queue-counter {
    width: 12;
    text-align: right;
    color: #ffaa55;
    text-style: bold;
}

#video-viewport {
    width: 100%;
    height: 1fr;
    align: center middle;
    text-align: center;
    background: #0b0d12;
    color: #d8dee9;
    border: round #1f2533;
    margin: 1 0;
}

#video-scrubber-bar {
    height: 1;
    width: 100%;
    background: #0d0f15;
    padding: 0 1;
}

#video-time-cur {
    width: 8;
    color: #ffaa55;
    text-style: bold;
}

#video-scrubber-line {
    width: 1fr;
    color: #ff8800;
    text-style: bold;
    text-align: center;
}

#video-time-dur {
    width: 8;
    text-align: right;
    color: #8899ac;
}

#video-controls-bar {
    height: 1;
    width: 100%;
    background: #11141c;
    color: #d8dee9;
    padding: 0 1;
}

#video-fmt-tag {
    width: 20;
    color: #ffaa55;
    text-style: bold;
}

#video-center-controls {
    width: 1fr;
    text-align: center;
    color: #ffffff;
    text-style: bold;
}

#video-right-status {
    width: 45;
    text-align: right;
    color: #8899ac;
}

/* ═══════════════════════════════════════ AUDIO ENVIRONMENT ═══════════════════════════════ */

#audio-screen-container {
    width: 100%;
    height: 100%;
    background: #090a0d;
    color: #e2e8f0;
    padding: 0 1;
}

#audio-header-bar {
    height: 1;
    width: 100%;
    background: #12151f;
    color: #ffffff;
    padding: 0 1;
}

#audio-brand {
    color: #ff8800;
    text-style: bold;
    width: 26;
}

#audio-queue-counter {
    width: 1fr;
    text-align: right;
    color: #ffaa55;
    text-style: bold;
}

#audio-hero {
    height: 1fr;
    width: 100%;
    background: #0d0f17;
    border: round #1e2436;
    margin: 1 0;
    padding: 1 2;
    align: center middle;
}

#audio-cover-art {
    width: 29;
    height: 9;
    background: #141824;
    color: #ffaa55;
    border: round #2a3248;
    text-align: center;
    align: center middle;
    margin-right: 2;
}

#audio-track-info {
    width: 1fr;
    height: 100%;
    align: left middle;
}

#audio-sub-label {
    color: #64748b;
    text-style: bold;
}

#audio-track-title {
    color: #ffffff;
    text-style: bold;
    margin-top: 0;
}

#audio-artist-name {
    color: #cbd5e1;
    text-style: bold;
}

#audio-album-name {
    color: #94a3b8;
}

#audio-fmt-badge {
    margin-top: 1;
    color: #ff8800;
}

#audio-scrubber-bar {
    height: 1;
    width: 100%;
    background: #0e111a;
    padding: 0 1;
}

#audio-time-cur {
    width: 8;
    color: #ffaa55;
    text-style: bold;
}

#audio-scrubber-line {
    width: 1fr;
    color: #3b82f6;
    text-style: bold;
    text-align: center;
}

#audio-time-dur {
    width: 8;
    text-align: right;
    color: #64748b;
}

#audio-sub-scrubber {
    height: 1;
    width: 100%;
    background: #090a0d;
    padding: 0 1;
}

#audio-sub-left {
    width: 20;
    color: #3b82f6;
    text-style: bold;
}

#audio-sub-right {
    width: 1fr;
    text-align: right;
    color: #64748b;
}

#audio-controls-bar {
    height: 1;
    width: 100%;
    background: #12151f;
    padding: 0 1;
}

#audio-loop-tag {
    width: 22;
    color: #94a3b8;
}

#audio-center-controls {
    width: 1fr;
    text-align: center;
    color: #ffffff;
    text-style: bold;
}

#audio-shuffle-tag {
    width: 22;
    text-align: right;
    color: #94a3b8;
}

#audio-footer-line {
    height: 1;
    width: 100%;
    background: #0e111a;
    color: #64748b;
    padding: 0 1;
}

#audio-vol-tag {
    width: 20;
    color: #ffaa55;
}

#audio-device-tag {
    width: 1fr;
    text-align: center;
    color: #64748b;
}

#audio-esc-tag {
    width: 26;
    text-align: right;
    color: #94a3b8;
}

/* ═══════════════════════════════════════ IMAGE ENVIRONMENT ═══════════════════════════════ */

#image-screen-container {
    width: 100%;
    height: 100%;
    background: #08090b;
    color: #e4e8ef;
    padding: 0 1;
}

#image-header-bar {
    height: 1;
    width: 100%;
    background: #11141c;
    color: #ffffff;
    padding: 0 1;
}

#image-brand {
    color: #ff8800;
    text-style: bold;
    width: 28;
}

#image-title-label {
    width: 1fr;
    text-align: center;
    color: #ffffff;
    text-style: bold;
}

#image-queue-counter {
    width: 12;
    text-align: right;
    color: #ffaa55;
    text-style: bold;
}

#image-viewport {
    width: 100%;
    height: 1fr;
    align: center middle;
    text-align: center;
    background: #0b0d12;
    color: #d8dee9;
    border: round #1f2533;
    margin: 1 0;
}

#image-meta-bar {
    height: 1;
    width: 100%;
    background: #11141c;
    color: #e4e8ef;
    text-align: center;
}

#image-controls-bar {
    height: 1;
    width: 100%;
    background: #090a0d;
    color: #8899ac;
    text-align: center;
}

/* ═══════════════════════════════════════ MODAL DIALOGS ═════════════════════════════════ */

.modal-dialog {
    width: 60;
    height: auto;
    max-height: 32;
    border: double #FF8800;
    background: #FFFDF8;
    padding: 1 2;
    align: center middle;
    color: #1A1A1A;
}

.dialog-header {
    color: #CC6600;
    text-style: bold;
    text-align: center;
    border-bottom: heavy #FF8800;
    margin-bottom: 1;
}

.hint-label {
    color: #666666;
    text-align: center;
    margin-top: 1;
}

/* ═══════════════════════════════════════ PLAYER STATUS ═════════════════════════════════ */

PlayerStatusWidget {
    height: 3;
    margin: 0 1;
    border: double #FF8800;
    background: #FFF5E8;
    padding: 0 2;
    align: center middle;
}

#player-bar {
    height: 1;
    width: 100%;
    align: center middle;
}

.bar-status {
    color: #CC6600;
    text-style: bold;
    width: 16;
}

.bar-title {
    color: #1A1A1A;
    text-style: bold;
    width: 1fr;
    text-align: center;
}

.bar-scrubber {
    color: #FF8800;
    width: 38;
    text-align: right;
}

/* ═══════════════════════════════════════ FOOTER ════════════════════════════════════════ */

ContextualFooter {
    height: 1;
}

#notification-bar {
    height: 1;
    color: #FFFFFF;
    text-style: bold;
    text-align: center;
    background: #FF8800;
}

Footer {
    background: #FFF5E8;
    color: #CC6600;
}
