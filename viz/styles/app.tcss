/* Viz Terminal Media Center — Professional Orange + White Theme Stylesheet */
/* Professional, keyboard-first design with Orange (#FF8800) accent palette */

* {
    scrollbar-size-vertical: 0;
    scrollbar-size-horizontal: 0;
    scrollbar-size: 0 0;
}

Screen {
    background: #FFFDF8;
    color: #1A1A1A;
}

/* ═══════════════════════════════════════ HEADER ═══════════════════════════════════════ */

HeaderWidget {
    align: center top;
    height: auto;
    max-height: 8;
    margin: 0;
    padding: 0;
    background: #FFFDF8;
    color: #FF8800;
}

#top-status-line {
    text-align: center;
    color: #FF8800;
    height: auto;
    background: #FFFDF8;
    width: 100%;
}

/* ═══════════════════════════════════════ MAIN LAYOUT ═══════════════════════════════════ */

.main-box {
    border: round #FF8800;
    height: 1fr;
    margin: 0 1;
    background: #FFFFFF;
}

.column {
    height: 100%;
    padding: 0 1;
}

#left-column {
    width: 25%;
    min-width: 22;
    height: 100%;
    padding: 0 1;
    border-right: solid #FFE1B8;
}

#center-column {
    width: 50%;
    min-width: 32;
    height: 100%;
    padding: 0 1;
    border-right: solid #FFE1B8;
}

#details-column {
    width: 25%;
    min-width: 22;
    height: 100%;
    padding: 0 1;
}

.column-header {
    text-style: bold;
    color: #CC6600;
    margin-bottom: 0;
    padding-bottom: 0;
    border-bottom: heavy #FF8800;
}

/* ═══════════════════════════════════════ FILESYSTEM TREE ═══════════════════════════════ */

#folder-tree {
    height: 1fr;
    min-height: 6;
    border: none;
    background: #FFFFFF;
    color: #1A1A1A;
    scrollbar-size-vertical: 0;
    scrollbar-size-horizontal: 0;
    scrollbar-size: 0 0;
}

#folder-tree:focus {
    border: none;
}

#folder-tree > .tree--cursor {
    background: #FFE1B8;
    color: #CC6600;
    text-style: bold;
}

#folder-tree > .tree--highlight {
    background: #FFF5E8;
    color: #FF8800;
}

/* ═══════════════════════════════════════ SIDEBAR SECTIONS ══════════════════════════════ */

.section-header {
    color: #CC6600;
    text-style: bold;
    padding-top: 0;
    margin-bottom: 0;
}

#storage-list, #personal-views-list, #system-list {
    height: auto;
    max-height: 4;
    border: none;
    background: #FFFFFF;
    scrollbar-size: 0 0;
}

#storage-list > ListItem, #personal-views-list > ListItem, #system-list > ListItem {
    padding: 0 1;
    color: #444444;
    background: #FFFFFF;
}

#storage-list > ListItem:hover, #personal-views-list > ListItem:hover, #system-list > ListItem:hover {
    background: #FFF5E8;
    color: #FF8800;
}

#storage-list > ListItem.--highlight, #personal-views-list > ListItem.--highlight, #system-list > ListItem.--highlight {
    background: #FFE1B8;
    color: #CC6600;
    text-style: bold;
}

/* ═══════════════════════════════════════ MEDIA LIST ════════════════════════════════════ */

#media-list {
    height: 1fr;
    border: none;
    background: #FFFFFF;
    scrollbar-size-vertical: 0;
    scrollbar-size-horizontal: 0;
    scrollbar-size: 0 0;
}

#media-list > ListItem {
    padding: 0 1;
    color: #1A1A1A;
    background: #FFFFFF;
}

#media-list > ListItem:hover {
    background: #FFF5E8;
    color: #FF8800;
}

#media-list > ListItem.--highlight {
    background: #FFE1B8;
    color: #CC6600;
    text-style: bold;
}

#details-body {
    height: 1fr;
    padding: 1 0;
    color: #1A1A1A;
    scrollbar-size: 0 0;
    overflow-y: auto;
}

#storage-header {
    margin-top: 1;
    margin-bottom: 0;
    border-top: solid #FF8800;
    color: #CC6600;
    text-style: bold;
}

#storage-body {
    height: auto;
    min-height: 6;
    padding: 0 0;
    color: #1A1A1A;
}


/* ═══════════════════════════════════════ IMAGE VIEWER ══════════════════════════════════ */

#image-screen-container {
    width: 100%;
    height: 100%;
    background: #FFFDF8;
    padding: 0 1;
}

#image-ascii-body {
    width: 100%;
    height: 1fr;
    align: center middle;
    text-align: center;
    background: #FFFDF8;
    border: double #FF8800;
    margin-bottom: 0;
    overflow-y: hidden;
    scrollbar-size: 0 0;
}

#image-meta-body {
    height: 3;
    text-align: center;
    color: #1A1A1A;
    background: #FFF5E8;
    border-top: solid #FF8800;
}

/* ═══════════════════════════════════════ VIDEO PLAYER ══════════════════════════════════ */

#video-screen-container {
    width: 100%;
    height: 100%;
    background: #FFFDF8;
    padding: 0 1;
}

#video-display-body {
    width: 100%;
    height: 1fr;
    align: center middle;
    text-align: center;
    background: #FFFDF8;
    border: double #FF8800;
    scrollbar-size: 0 0;
}

#video-status-bar {
    height: 1;
    background: #FFF5E8;
    color: #CC6600;
    text-style: bold;
}

#video-progress-bar {
    height: 1;
    background: #FFFDF8;
    color: #FF8800;
    text-style: bold;
}

/* ═══════════════════════════════════════ AUDIO PLAYER ══════════════════════════════════ */

#audio-screen-container {
    width: 100%;
    height: 100%;
    background: #FFFDF8;
    padding: 0 1;
}

#audio-display-body {
    width: 100%;
    height: 1fr;
    align: center middle;
    text-align: center;
    background: #FFFDF8;
    border: double #FF8800;
    scrollbar-size: 0 0;
}

#audio-info-footer {
    height: 1;
    background: #FFF5E8;
    color: #CC6600;
    text-style: bold;
    text-align: center;
}

/* ═══════════════════════════════════════ MODAL DIALOGS ═════════════════════════════════ */

.modal-dialog {
    width: 60;
    height: auto;
    max-height: 32;
    border: double #FF8800;
    background: #FFFDF8;
    padding: 1 2;
    align: center middle;
    color: #1A1A1A;
}

.dialog-header {
    color: #CC6600;
    text-style: bold;
    text-align: center;
    border-bottom: heavy #FF8800;
    margin-bottom: 1;
}

.hint-label {
    color: #666666;
    text-align: center;
    margin-top: 1;
}

/* ═══════════════════════════════════════ PLAYER STATUS ═════════════════════════════════ */

PlayerStatusWidget {
    height: 3;
    margin: 0 1;
    border: double #FF8800;
    background: #FFF5E8;
    padding: 0 2;
    align: center middle;
}

#player-bar {
    height: 1;
    width: 100%;
    align: center middle;
}

.bar-status {
    color: #CC6600;
    text-style: bold;
    width: 16;
}

.bar-title {
    color: #1A1A1A;
    text-style: bold;
    width: 1fr;
    text-align: center;
}

.bar-scrubber {
    color: #FF8800;
    width: 38;
    text-align: right;
}

/* ═══════════════════════════════════════ FOOTER ════════════════════════════════════════ */

ContextualFooter {
    height: 1;
}

#notification-bar {
    height: 1;
    color: #FFFFFF;
    text-style: bold;
    text-align: center;
    background: #FF8800;
}

Footer {
    background: #FFF5E8;
    color: #CC6600;
}
