/* Viz Terminal Media Center - Retro Hacker/VCR Orange Theme Stylesheet */

Screen {
    background: #0c0905;
    color: #ffccaa;
}

/* Header Component */
HeaderWidget {
    align: center top;
    height: 7;
    margin-top: 1;
    margin-bottom: 0;
}

#ascii-header {
    text-align: center;
    color: #ff8800;
    text-style: bold;
    height: 6;
}

#top-status-line {
    text-align: center;
    color: #ff9900;
    text-style: bold;
    height: 1;
    background: #140d06;
}

/* Search Component */
SearchWidget {
    align: center top;
    height: 3;
    margin-top: 0;
    margin-bottom: 1;
}

#search-input {
    width: 76;
    border: tall #ff8800;
    background: #140d06;
    color: #ff8800;
    padding: 0 1;
}

#search-input:focus {
    border: double #ff9900;
    background: #1c1208;
}

/* Main Navigation Box (Three-Area Layout) */
.main-box {
    border: round #ff8800;
    height: 1fr;
    margin: 0 2;
    background: #0f0a05;
}

.column {
    height: 100%;
    padding: 1 1;
}

#left-column {
    width: 34;
    border-right: solid #33200d;
}

#right-column {
    width: 1fr;
    border-right: solid #33200d;
}

#details-column {
    width: 34;
}

.column-header {
    text-style: bold;
    color: #ff8800;
    margin-bottom: 1;
    padding-bottom: 0;
    border-bottom: heavy #ff8800;
}

/* Tree Widget Styling */
#folder-tree {
    height: 1fr;
    border: none;
    background: transparent;
    color: #ffccaa;
}

#folder-tree:focus {
    border: none;
}

#folder-tree > .tree--cursor {
    background: #ff8800;
    color: #000000;
    text-style: bold;
}

/* Section Header in Sidebar */
.section-header {
    color: #cc6600;
    text-style: bold;
    padding-top: 1;
    margin-bottom: 0;
}

/* Global & System Lists */
#global-views-list, #system-list {
    height: auto;
    max-height: 12;
    border: none;
    background: transparent;
}

#global-views-list > ListItem, #system-list > ListItem {
    padding: 0 1;
    color: #d99966;
    background: transparent;
}

#global-views-list > ListItem:hover, #system-list > ListItem:hover {
    background: #241407;
    color: #ff8800;
}

#global-views-list > ListItem.--highlight, #system-list > ListItem.--highlight {
    background: #ff8800;
    color: #000000;
    text-style: bold;
}

/* Dynamic Media List (Middle Column) */
#media-list {
    height: 1fr;
    border: none;
    background: transparent;
}

#media-list > ListItem {
    padding: 0 1;
    color: #ffccaa;
    background: transparent;
}

#media-list > ListItem:hover {
    background: #241407;
    color: #ff8800;
}

#media-list > ListItem.--highlight {
    background: #ff8800;
    color: #000000;
    text-style: bold;
}

/* Details Panel (Right Column) */
#details-body {
    padding: 1;
    color: #ffccaa;
}

/* Modal Dialog Screens */
.modal-dialog {
    width: 60;
    height: auto;
    max-height: 32;
    border: double #ff8800;
    background: #140d06;
    padding: 1 2;
    align: center middle;
}

.dialog-header {
    color: #ff8800;
    text-style: bold;
    text-align: center;
    border-bottom: heavy #ff8800;
    margin-bottom: 1;
}

.hint-label {
    color: #d99966;
    text-align: center;
    margin-top: 1;
}

#image-dialog {
    width: 68;
    height: 28;
}

#image-ascii-body {
    height: 15;
    text-align: center;
    color: #ff8800;
    background: #090603;
    border: solid #33200d;
    margin-bottom: 1;
}

#image-meta-body {
    height: 4;
    text-align: center;
}

/* Player Status Bar */
PlayerStatusWidget {
    height: 3;
    margin: 0 2;
    border: double #ff8800;
    background: #140e07;
    padding: 0 2;
    align: center middle;
}

#player-bar {
    height: 1;
    width: 100%;
    align: center middle;
}

.bar-status {
    color: #ff8800;
    text-style: bold;
    width: 16;
}

.bar-title {
    color: #ffffff;
    text-style: bold;
    width: 1fr;
    text-align: center;
}

.bar-scrubber {
    color: #ff9900;
    width: 38;
    text-align: right;
}

/* Contextual Footer */
ContextualFooter {
    height: 1;
}

#notification-bar {
    height: 1;
    color: #ff8800;
    text-style: bold;
    text-align: center;
    background: #1a1005;
}

Footer {
    background: #080503;
    color: #ff8800;
}
