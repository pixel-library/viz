/* Viz Terminal Media Center - Retro Orange + Off-White Palette Stylesheet */

Screen {
    background: #FFFDF9;
    color: #1A1A1A;
}

/* Header Component */
HeaderWidget {
    align: center top;
    height: 5;
    margin: 0;
    padding: 0;
    background: #FFF5E8;
    border-bottom: solid #FF8C00;
}

#ascii-header {
    text-align: center;
    color: #FF7A00;
    text-style: bold;
    height: 4;
}

#top-status-line {
    text-align: center;
    color: #E85D00;
    text-style: bold;
    height: 1;
    background: #FFE8D1;
}

/* Main Navigation Box (Three-Area Layout) */
.main-box {
    border: round #FF8C00;
    height: 1fr;
    margin: 0 1;
    background: #FFFFFF;
}

.column {
    height: 100%;
    padding: 0 1;
}

#left-column {
    width: 34;
    height: 100%;
    border-right: solid #FFE0C2;
}

#right-column {
    width: 1fr;
    height: 100%;
    border-right: solid #FFE0C2;
}

#details-column {
    width: 34;
    height: 100%;
}

.column-header {
    text-style: bold;
    color: #E85D00;
    margin-bottom: 0;
    padding-bottom: 0;
    border-bottom: heavy #FF8C00;
}

/* Tree Widget Styling */
#folder-tree {
    height: 1fr;
    min-height: 8;
    border: none;
    background: #FFFFFF;
    color: #1A1A1A;
}

#folder-tree:focus {
    border: none;
}

#folder-tree > .tree--cursor {
    background: #FF8C00;
    color: #FFFFFF;
    text-style: bold;
}

/* Section Header in Sidebar */
.section-header {
    color: #E85D00;
    text-style: bold;
    padding-top: 0;
    margin-bottom: 0;
}

/* Sidebar Lists */
#storage-list, #personal-views-list, #system-list {
    height: auto;
    max-height: 5;
    border: none;
    background: #FFFFFF;
}

#storage-list > ListItem, #personal-views-list > ListItem, #system-list > ListItem {
    padding: 0 1;
    color: #444444;
    background: #FFFFFF;
}

#storage-list > ListItem:hover, #personal-views-list > ListItem:hover, #system-list > ListItem:hover {
    background: #FFF0E0;
    color: #FF7A00;
}

#storage-list > ListItem.--highlight, #personal-views-list > ListItem.--highlight, #system-list > ListItem.--highlight {
    background: #FF8C00;
    color: #FFFFFF;
    text-style: bold;
}

/* Dynamic Media List (Middle Column) */
#media-list {
    height: 1fr;
    border: none;
    background: #FFFFFF;
}

#media-list > ListItem {
    padding: 0 1;
    color: #1A1A1A;
    background: #FFFFFF;
}

#media-list > ListItem:hover {
    background: #FFF0E0;
    color: #FF7A00;
}

#media-list > ListItem.--highlight {
    background: #FF8C00;
    color: #FFFFFF;
    text-style: bold;
}

/* Details Panel (Right Column) */
#details-body {
    padding: 1;
    color: #1A1A1A;
}

/* Full Terminal Image Viewer Screen */
#image-screen-container {
    width: 100%;
    height: 100%;
    background: #FFFDF9;
    padding: 0 1;
}

#image-ascii-body {
    width: 100%;
    height: 1fr;
    align: center middle;
    text-align: center;
    background: #FFFDF9;
    border: double #FF8C00;
    margin-bottom: 0;
}

#image-meta-body {
    height: 3;
    text-align: center;
    color: #1A1A1A;
    background: #FFF5E8;
    border-top: solid #FF8C00;
}

/* Modal Dialog Screens */
.modal-dialog {
    width: 60;
    height: auto;
    max-height: 32;
    border: double #FF8C00;
    background: #FFFDF9;
    padding: 1 2;
    align: center middle;
    color: #1A1A1A;
}

.dialog-header {
    color: #E85D00;
    text-style: bold;
    text-align: center;
    border-bottom: heavy #FF8C00;
    margin-bottom: 1;
}

.hint-label {
    color: #666666;
    text-align: center;
    margin-top: 1;
}

/* Player Status Bar */
PlayerStatusWidget {
    height: 3;
    margin: 0 1;
    border: double #FF8C00;
    background: #FFF5E8;
    padding: 0 2;
    align: center middle;
}

#player-bar {
    height: 1;
    width: 100%;
    align: center middle;
}

.bar-status {
    color: #E85D00;
    text-style: bold;
    width: 16;
}

.bar-title {
    color: #1A1A1A;
    text-style: bold;
    width: 1fr;
    text-align: center;
}

.bar-scrubber {
    color: #FF7A00;
    width: 38;
    text-align: right;
}

/* Contextual Footer */
ContextualFooter {
    height: 1;
}

#notification-bar {
    height: 1;
    color: #FFFFFF;
    text-style: bold;
    text-align: center;
    background: #FF8C00;
}

Footer {
    background: #FFF5E8;
    color: #E85D00;
}


